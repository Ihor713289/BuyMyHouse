{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "Tables": {
      "Provider": "Azure",
      "ConnectionString": "UseDevelopmentStorage=true",
      "TableName": "listings",
      "UsersTableName": "users",
      "MortgageApplicationsTableName": "mortgageapplications"
    },
    "Queues": {
      "Provider": "Azure",
      "ConnectionString": "UseDevelopmentStorage=true",
      "QueueName": "mortgage-applications"
    },
    "Blobs": {
      "Provider": "Azure",
      "ConnectionString": "UseDevelopmentStorage=true",
      "ContainerName": "listing-images"
    }
  },
  "Jwt": {
    "Issuer": "BuyMyHouse",
    "Audience": "BuyMyHouse",
    "SigningKey": "",
    "ExpiryMinutes": 60
  }
}
